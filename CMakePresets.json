{
    "version": 4,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cpp/Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cpp/Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "docker",
            "displayName": "Docker Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cpp/Docker",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-default",
            "configurePreset": "default"
        },
        {
            "name": "build-debug",
            "configurePreset": "debug"
        },
        {
            "name": "build-docker",
            "configurePreset": "docker",
            "targets": [
                "compression_python"
            ]
        }
    ]
}
